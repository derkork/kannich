<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>dev.kannich</groupId>
    <artifactId>kannich-parent</artifactId>
    <version>0.10.0</version>
    <packaging>pom</packaging>

    <name>Kannich Parent</name>
    <description>Parent POM for Kannich modules</description>
    <url>https://kannich.dev</url>

    <!-- Build order matters: bom first, then core modules, then extensions -->
    <modules>
        <module>kannich-bom</module>
        <module>kannich-stdlib</module>
        <module>kannich-tools</module>
        <module>kannich-runtime</module>
        <module>kannich-cli</module>
        <module>kannich-test</module>
        <module>kannich-java</module>
        <module>kannich-maven</module>
        <module>kannich-quarkus</module>
        <module>kannich-trivy</module>
        <module>kannich-terraform</module>
        <module>kannich-pre-commit</module>
        <module>kannich-helm</module>
        <module>kannich-aws-cli</module>
        <module>kannich-gcloud-cli</module>
        <module>kannich-uv</module>
        <module>kannich-node</module>
        <module>kannich-ggg</module>
    </modules>

    <licenses>
        <license>
            <name>The Apache Software License, Version 2.0</name>
            <url>http://www.apache.org/licenses/LICENSE-2.0.txt</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>Jan Thomae</name>
            <email>janthomae@janthomae.de</email>
            <organization>Ancient Light Studios</organization>
            <organizationUrl>https://www.ancientlightstudios.com</organizationUrl>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://forgejo.osthoehe41.de/derkork/kannich.git</connection>
        <developerConnection>scm:git:ssh://git@forgejo.osthoehe41.de:2222/derkork/kannich.git</developerConnection>
        <url>https://forgejo.osthoehe41.de/derkork/kannich</url>
    </scm>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <kotlin.code.style>official</kotlin.code.style>
        <kotlin.compiler.jvmTarget>21</kotlin.compiler.jvmTarget>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>

        <!-- Kotlin version. This should match the one from the BOM. Currently, Maven has no way to enforce this. -->
        <kotlin.version>2.1.0</kotlin.version>
    </properties>

    <repositories>
        <repository>
            <id>mavenCentral</id>
            <url>https://repo1.maven.org/maven2/</url>
        </repository>
    </repositories>

    <build>
        <sourceDirectory>src/main/kotlin</sourceDirectory>
        <testSourceDirectory>src/test/kotlin</testSourceDirectory>

        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.jetbrains.kotlin</groupId>
                    <artifactId>kotlin-maven-plugin</artifactId>
                    <version>${kotlin.version}</version>
                    <executions>
                        <execution>
                            <id>compile</id>
                            <phase>compile</phase>
                            <goals>
                                <goal>compile</goal>
                            </goals>
                        </execution>
                        <execution>
                            <id>test-compile</id>
                            <phase>test-compile</phase>
                            <goals>
                                <goal>test-compile</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.2</version>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>3.5.2</version>
                    <configuration>
                        <systemPropertyVariables>
                            <kannich.test.m2repo>${settings.localRepository}</kannich.test.m2repo>
                            <kannich.test.module.groupId>${project.groupId}</kannich.test.module.groupId>
                            <kannich.test.module.artifactId>${project.artifactId}</kannich.test.module.artifactId>
                            <kannich.test.module.version>${project.version}</kannich.test.module.version>
                        </systemPropertyVariables>
                    </configuration>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-install-plugin</artifactId>
                    <version>3.1.3</version>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>3.4.2</version>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-shade-plugin</artifactId>
                    <version>3.6.0</version>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-deploy-plugin</artifactId>
                    <version>3.1.1</version>
                    <configuration>
                        <skip>true</skip>
                    </configuration>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-source-plugin</artifactId>
                    <version>3.3.0</version>
                    <executions>
                        <execution>
                            <id>attach-sources</id>
                            <goals>
                                <goal>jar-no-fork</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>

                <plugin>
                    <groupId>org.jetbrains.dokka</groupId>
                    <artifactId>dokka-maven-plugin</artifactId>
                    <version>1.9.10</version>
                    <executions>
                        <execution>
                            <id>attach-javadocs</id>
                            <phase>verify</phase>
                            <goals>
                                <goal>javadocJar</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-gpg-plugin</artifactId>
                    <version>3.2.8</version>
                    <executions>
                        <execution>
                            <id>sign-artifacts</id>
                            <phase>verify</phase>
                            <goals>
                                <goal>sign</goal>
                            </goals>
                            <configuration>
                                <gpgArguments>
                                    <arg>--pinentry-mode</arg>
                                    <arg>loopback</arg>
                                </gpgArguments>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>

                <plugin>
                    <groupId>org.sonatype.central</groupId>
                    <artifactId>central-publishing-maven-plugin</artifactId>
                    <version>0.10.0</version>
                    <extensions>true</extensions>
                    <configuration>
                        <publishingServerId>ossrh</publishingServerId>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <plugin>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Bootstrap profile: includes the Docker builder image -->
        <!-- Usage: mvn -Pbootstrap install -->
        <profile>
            <id>bootstrap</id>
            <modules>
                <module>kannich-builder-image</module>
            </modules>
            <properties>
                <skipTests>true</skipTests>
            </properties>
        </profile>

        <!-- Integration tests profile: runs all .tests.main.kts scripts via kannichw.
             Usage: mvn verify -Pintegration-tests -->
        <profile>
            <id>integration-tests</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.gmavenplus</groupId>
                        <artifactId>gmavenplus-plugin</artifactId>
                        <version>4.3.1</version>
                        <dependencies>
                            <dependency>
                                <groupId>org.apache.groovy</groupId>
                                <artifactId>groovy</artifactId>
                                <version>4.0.26</version>
                                <scope>runtime</scope>
                            </dependency>
                            <dependency>
                                <groupId>org.apache.groovy</groupId>
                                <artifactId>groovy-ant</artifactId>
                                <version>4.0.26</version>
                                <scope>runtime</scope>
                            </dependency>
                        </dependencies>
                        <executions>
                            <execution>
                                <id>run-kannich-tests</id>
                                <phase>integration-test</phase>
                                <goals><goal>execute</goal></goals>
                                <configuration>
                                    <scripts>
                                        <script>
                                            // do not repeat all the tests for each module, only run them once
                                            // in the main module.
                                            def rootDir = session.executionRootDirectory as File
                                            if (project.basedir.canonicalPath != rootDir.canonicalPath) return

                                            def isWindows = System.getProperty("os.name").toLowerCase().contains("win")
                                            def platform = System.getProperty("platform")
                                            def clear = System.getProperty("clear") != null
                                            def group = System.getProperty("group")
                                            def verbose = System.getProperty("verbose") != null

                                            def testFiles = []
                                            rootDir.eachFileRecurse { file ->
                                                if (file.name == ".tests.main.kts") testFiles &lt;&lt; file
                                            }
                                            testFiles.sort { it.path }

                                            def includeModules = System.getProperty("include")?.split(",")?.collect { it.trim() }
                                            def excludeModules = System.getProperty("exclude")?.split(",")?.collect { it.trim() }
                                            if (includeModules) {
                                                testFiles = testFiles.findAll { file ->
                                                    includeModules.contains(file.parentFile.name)
                                                }
                                            }
                                            if (excludeModules) {
                                                testFiles = testFiles.findAll { file ->
                                                    !excludeModules.contains(file.parentFile.name)
                                                }
                                            }

                                            def envVars = platform
                                                ? (System.getenv().collect { k, v -> "${k}=${v}" } + ["KANNICH_DOCKER_OPTS=--platform ${platform}"]) as String[]
                                                : null

                                            testFiles.each { testFile ->
                                                def relativePath = rootDir.toURI().relativize(testFile.toURI()).toString()
                                                println "==> Running ${relativePath}"
                                                def cmd = isWindows
                                                    ? ["powershell", "-File", new File(rootDir, "kannichw.ps1").absolutePath, "-d", "-f", relativePath, "test"]
                                                    : [new File(rootDir, "kannichw").absolutePath, "-d", "-f", relativePath, "test"]
                                                if (clear) cmd += ["-e", "KANNICH_TEST_CLEAR=true"]
                                                if (group) cmd += ["-e", "KANNICH_TEST_GROUP=${group}"]
                                                if (verbose) cmd += ["-v"]
                                                def proc = cmd.execute(envVars, rootDir)
                                                proc.consumeProcessOutput(System.out, System.err)
                                                proc.waitFor()
                                                if (proc.exitValue() != 0) throw new RuntimeException("Test failed: ${testFile}")
                                            }
                                        </script>
                                    </scripts>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
